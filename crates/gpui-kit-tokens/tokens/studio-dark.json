{
  "$schema": "./schema.json",
  "meta": {
    "id": "studio-dark",
    "name": "Studio Dark",
    "appearance": "dark"
  },
  "color": {
    "palette": {
      "neutral": {
        "0": "#000000",
        "25": "#050505",
        "50": "#0a0a0a",
        "100": "#151515",
        "150": "#1c1c1c",
        "200": "#242424",
        "300": "#303030",
        "500": "#565656",
        "600": "#737373",
        "700": "#a1a1a1",
        "800": "#e9e9e9",
        "850": "#ebebeb",
        "900": "#ffffff",
        "ink": "#0e0e0e"
      },
      "indigo": {
        "400": "#7c86ff",
        "600": "#5865f2"
      },
      "red": {
        "400": "#ff6467"
      },
      "amber": {
        "500": "#ffb900"
      },
      "green": {
        "500": "#57c47f"
      },
      "cyan": {
        "400": "#7fb3cf"
      },
      "loader": {
        "blue": "#b6d3ef",
        "orange": "#edb185",
        "pink": "#f888a0"
      }
    },
    "surface": {
      "canvas": "{neutral.50}",
      "sunken": "{neutral.25}",
      "panel": "{neutral.100}",
      "raised": "{neutral.200}",
      "overlay": "{neutral.150}"
    },
    "text": {
      "primary": "{neutral.800}",
      "muted": "{neutral.700}",
      "faint": "{neutral.600}",
      "onAccent": "{neutral.ink}"
    },
    "interactive": {
      "hover": "{neutral.850}/24",
      "active": "{neutral.850}/29",
      "selected": "{neutral.850}/24",
      "hairline": "{neutral.900}/14",
      "hairlineStrong": "{neutral.900}/24",
      "focus": "{indigo.400}"
    },
    "semantic": {
      "accent": "{indigo.400}",
      "accentStrong": "{indigo.600}",
      "danger": "{red.400}",
      "warning": "{amber.500}",
      "success": "{green.500}",
      "info": "{cyan.400}"
    },
    "loader": {
      "gradient": ["{loader.blue}", "{loader.orange}", "{loader.pink}"]
    }
  },
  "space": {
    "xs": 4,
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "xxl": 32
  },
  "radius": {
    "small": 5,
    "control": 8,
    "card": 12,
    "dialog": 16,
    "bubble": 16,
    "pill": 999
  },
  "control": {
    "xs": { "height": 20, "paddingX": 6, "gap": 4, "fontSize": 11, "iconSize": 12 },
    "sm": { "height": 24, "paddingX": 8, "gap": 5, "fontSize": 12, "iconSize": 14 },
    "md": { "height": 28, "paddingX": 12, "gap": 6, "fontSize": 13, "iconSize": 15 },
    "lg": { "height": 34, "paddingX": 16, "gap": 8, "fontSize": 14, "iconSize": 17 }
  },
  "border": {
    "hairline": 1,
    "thick": 2
  },
  "opacity": {
    "disabled": 0.45,
    "muted": 0.68,
    "scrim": 0.6
  },
  "elevation": {
    "flat": { "y": 0, "blur": 0, "spread": 0, "color": "{neutral.0}/00" },
    "raised": { "y": 2, "blur": 6, "spread": -1, "color": "{neutral.0}/59" },
    "overlay": { "y": 8, "blur": 24, "spread": -4, "color": "{neutral.0}/66" },
    "modal": { "y": 16, "blur": 48, "spread": -8, "color": "{neutral.0}/8c" }
  },
  "zIndex": {
    "content": 0,
    "sticky": 100,
    "dock": 200,
    "popover": 300,
    "tooltip": 400,
    "modal": 500,
    "toast": 600
  },
  "density": {
    "compact": { "space": 0.75, "control": 0.86, "font": 0.94 },
    "comfortable": { "space": 1, "control": 1, "font": 1 }
  },
  "typography": {
    "sans": {
      "family": "Geist",
      "fallbackMacos": "Helvetica",
      "fallbackWindows": "Segoe UI",
      "fallbackLinux": "DejaVu Sans"
    },
    "mono": {
      "family": "Geist Mono",
      "fallbackMacos": "Menlo",
      "fallbackWindows": "Consolas",
      "fallbackLinux": "DejaVu Sans Mono"
    },
    "scale": {
      "caption": { "size": 10.5, "lineHeight": 14, "weight": 400 },
      "label": { "size": 12, "lineHeight": 16, "weight": 500 },
      "body": { "size": 13, "lineHeight": 19, "weight": 400 },
      "title": { "size": 16, "lineHeight": 22, "weight": 600 },
      "code": { "size": 12, "lineHeight": 18, "weight": 400 }
    }
  },
  "motion": {
    "durationMs": {
      "instant": 90,
      "quick": 150,
      "menu": 140,
      "dialog": 180,
      "resize": 200,
      "entrance": 500,
      "slow": 320,
      "staggerStep": 28,
      "spin": 900,
      "pulse": 2400,
      "shimmer": 1400,
      "toast": 6000
    },
    "easing": {
      "linear": [0, 0, 1, 1],
      "standard": [0.4, 0, 0.2, 1],
      "easeIn": [0.42, 0, 1, 1],
      "easeOut": [0, 0, 0.58, 1],
      "easeInOut": [0.42, 0, 0.58, 1],
      "emphasized": [0.2, 0, 0, 1],
      "overshoot": [0.34, 1.56, 0.64, 1],
      "exit": [0, 0, 0.58, 1],
      "settle": [0.16, 1, 0.3, 1]
    },
    "spring": {
      "snappy": { "stiffness": 380, "damping": 30, "mass": 1 },
      "smooth": { "stiffness": 180, "damping": 26, "mass": 1 },
      "bouncy": { "stiffness": 260, "damping": 16, "mass": 1 },
      "grab": { "stiffness": 520, "damping": 42, "mass": 1 }
    },
    "pressOffsetPx": 1,
    "hoverLiftPx": 1,
    "flickVelocityPxPerSec": 420,
    "rubberBandTension": 0.55
  },
  "effect": {
    "edgeFadeBand": 20,
    "selectedRingAlpha": 0.09,
    "focusRingWidth": 2,
    "focusRingAlpha": 0.55,
    "glowAlpha": 0.38,
    "glowBlur": 12
  }
}
