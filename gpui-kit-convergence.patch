+        ("browser.loading", "loading"),
+        ("browser.empty", "empty"),
+        ("browser.unavailable", "unavailable"),
+        ("browser.error", "error"),
+        ("browser.ready", "ready"),
+    ] {
+        assert_eq!(
+            harness.node(id).expect("browser state").value.as_deref(),
+            Some(expected)
