+        assert_eq!(
+            harness
+                .node(&format!("{id}.viewport"))
+                .expect("stable viewport")
+                .value
+                .as_deref(),
+            Some(expected)
+        );
+    }
+    assert!(harness.node("browser.loading").expect("loading").busy);
+    assert!(
+        !harness
+            .node("browser.unavailable")
