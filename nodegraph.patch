+        assert_eq!(doubled.caption_size, theme.typography.caption.size * 2.0);
+        assert_eq!(doubled.icon_size, theme.control.sm.icon_size * 2.0);
+        assert_eq!(doubled.radius, theme.radius(Radius::Card) * 2.0);
+    }
 }
